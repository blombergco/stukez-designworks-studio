#!/bin/sh
# Pre-push checks for the public repo: no private material in the pushed commits, and ruff passes.
# Enable once per clone (stored in .git/config, not in the repo):
#   git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
py -3 scripts/check_push.py || exit 1
py -3 -m ruff check --quiet . || exit 1
